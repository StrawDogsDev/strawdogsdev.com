  { cover: "get-better", cat: "FranklinCovey", title: "Get Better", who: "Todd Davis", note: "Chief People Officer, FranklinCovey · Fifteen practices for relationships at work" },
  { cover: "everyone-deserves", cat: "FranklinCovey", title: "Everyone Deserves a Great Manager", who: "Scott Miller · Todd Davis · Victoria Roos Olsson", note: "The six critical practices for leading a team" },
  { cover: "master-mentors", cat: "FranklinCovey", title: "Master Mentors, Vol. 1", who: "Scott Jeffrey Miller", note: "Thirty transformative insights from our greatest minds" },
  { cover: "master-mentors-2", cat: "FranklinCovey", title: "Master Mentors, Vol. 2", who: "Scott Jeffrey Miller", note: "Thirty more insights from FranklinCovey's On Leadership podcast" },
  { cover: "leading-loyalty", cat: "FranklinCovey", title: "Leading Loyalty", who: "Sandy Rogers · Leena Rinne · Shawn Moon", note: "Cracking the code to customer devotion" },
  { cover: "management-mess", cat: "FranklinCovey", title: "Management Mess to Leadership Success", who: "Scott Jeffrey Miller", note: "Thirty challenges to become the leader you would follow" },
  { cover: "marketing-mess", cat: "FranklinCovey", title: "Marketing Mess to Brand Success", who: "Scott Jeffrey Miller", note: "Thirty challenges to transform your organization's brand" },
  { cover: "strikingly-different", cat: "FranklinCovey", title: "Strikingly Different Selling", who: "Merrill · Savage · Illig · Colosimo", note: "Six vital skills to stand out and sell more" },
  { cover: "who-rocked", cat: "FranklinCovey", title: "Who Rocked the Boat?", who: "Curtis Bateman", note: "A story about navigating the inevitability of change" },
  { cover: "change", cat: "FranklinCovey", title: "Change", who: "Bateman · Pleshette · Cindrich · Phillips", note: "How to turn uncertainty into opportunity" },
  { cover: "ultimate-mentorship", cat: "HarperCollins Leadership", title: "The Ultimate Guide to Great Mentorship", who: "Scott Jeffrey Miller", note: "Thirteen roles to making a true impact" },
  { cover: "career-on-course", cat: "Career", title: "Career on Course", who: "Scott Jeffrey Miller", note: "Ten strategies to take your career from accidental to intentional" },
  { cover: "parenting-wrong-turns", cat: "Family", title: "Parenting: Wrong Turns, Right Lessons", who: "Scott Jeffrey Miller & Thatcher Ford Miller", note: "Thirty insights to build lifelong influence with your children" },
  { cover: "entrepreneurs-paradox", cat: "Startups", title: "The Entrepreneur's Paradox", who: "Curtis Morley", note: "How to overcome the sixteen pitfalls of the startup journey" },
  { cover: "deliver", cat: "Leadership", title: "Deliver", who: "Russ Hill · Jared Jones · Tanner Corbridge", note: "Why some leaders get results and most don't" },
  { cover: "hidden-strengths", cat: "Personal Growth", title: "Find Your Hidden Strengths", who: "Matthew E. Poll", note: "The four archetypes for success and personal growth" },
  { cover: "hidden-value", cat: "Learning & Development", title: "Hidden Value", who: "Dr. Keith Keating", note: "How to reveal the impact of organizational learning" },
  { cover: "breakproof", cat: "Resilience", title: "BreakProof", who: "Jenn Drummond", note: "First woman to climb the Seven Second Summits · Seven strategies to build resilience" },
  { cover: "last-book", cat: "USA Today Bestseller", title: "The Last Book Written by a Human", who: "Jeff Burningham", note: "Becoming wise in the age of AI" },
  { cover: "when-did-you", cat: "#1 International Bestseller", title: "When Did You Stop Caring?", who: "Natalie D. Beckerman", note: "The call to reignite humanity in a world obsessed with efficiency" },
  { cover: "loose-cannons", cat: "Memoir", title: "Loose Cannons", who: "Diana Cannon Ragsdale", note: "A literary family memoir" },
  { cover: "mind-strength", cat: "Sports · Mental Performance", title: "The Mind Strength Playbook", who: "Luke Falk", note: "Former NFL Quarterback · Mental-Strength Coach" },
  { cover: "stupider-people", cat: "#1 Bestseller · 2026", title: "Stupider People Have Done It", who: "Jay Schwedelson", note: "Marketing truths, career moves, and life advice for doers" },
  { cover: "life-is-luck", cat: "Memoir", title: "Life is Luck", who: "John Morgan", note: "Founder, Morgan & Morgan · America's largest plaintiffs' firm" },
  { cover: "line-maker", cat: "2026", title: "The Line Maker", who: "Brett Armstrong", note: "Live intentionally. No excuses." },
  { cover: "pressure-code", cat: "Forthcoming · 2026", title: "The Pressure Code", who: "Jason Stacy", note: "Performance coach to Aryna Sabalenka and the WTA tour" },
  { cover: "stay-dangerous", cat: "In Development", title: "Stay Dangerous", who: "Ara Suppiah, M.D.", note: "Defying a world that wants to tame you" },
  { cover: "strong-enough", cat: "Maison Vero", title: "Strong Enough to Listen", who: "Lisa Duran", note: "Bridging the communication gap between our choices and our responses" },
  { cover: "becoming-unforgettable", cat: "Forthcoming · 2027", title: "Becoming Unforgettable", who: "Lisa Nichols", note: "The seven principles of earned influence · Simon & Schuster" },
  { cover: "daymakers", cat: "Forthcoming · 2026", title: "Daymakers", who: "Jay O'Brien & Jeff Jackel", note: "Co-founders, Client Giant" },
  { cover: "carbon-based-living", cat: "Forthcoming · 2026", title: "Carbon-Based Living", who: "Scott Alan Fossler", note: "Unlocking the science of human potential" },
  { cover: "inherited-machine", cat: "Forthcoming · 2026", title: "The Inherited Machine", who: "Dr. Greg Morris", note: "A human OS for leadership and collaboration" },
];
---

<section id="work" class="section fade-in">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow" style="display:block; margin-bottom:1rem;">Selected Work</span>
      <h2 class="h2" style="margin-bottom:1.5rem;">Books we've helped <span class="display-italic">build.</span></h2>
      <p class="lede" style="font-size:clamp(1.05rem,1.7vw,1.3rem);">
        Over thirty trade nonfiction titles across leadership, sales, marketing, sports performance,
        behavioral change, and memoir.
      </p>
    </div>

    <div class="shelf-unit" id="shelf">
      <ul class="shelf" role="list">
        {books.map((b, i) => (
          <li>
            <button class="jacket" type="button" data-i={i} aria-describedby="shelf-readout">
              <img
                src={`/images/covers/${b.cover}.webp`}
                alt={`${b.title} — ${b.who}`}
                width="307" height="460" loading="lazy" decoding="async"
              />
            </button>
          </li>
        ))}
      </ul>

      <div class="readout" id="shelf-readout">
        {books.map((b, i) => (
          <div class="read" data-i={i} hidden={i !== 0}>
            <p class="read-cat">{b.cat}</p>
            <h3 class="h3 read-title">{b.title}</h3>
            <p class="read-who">{b.who}</p>
            <p class="read-note">{b.note}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .shelf-unit { display: grid; grid-template-columns: 1fr 20rem; gap: 2.6rem; align-items: start; }

  .shelf {
    display: flex; flex-wrap: wrap; gap: 1.15rem 1rem;
    list-style: none; margin: 0; padding: 0;
  }
  .shelf li { margin: 0; }

  .jacket {
    display: block; padding: 0; border: 0; background: none; cursor: pointer;
    line-height: 0; border-radius: 2px;
    /* resting state: on the shelf, not in the light */
    filter: saturate(0.55) brightness(0.94);
    opacity: 0.62;
    transform: translateY(0);
    transition: opacity 0.7s ease, filter 0.7s ease, transform 0.5s ease, box-shadow 0.5s ease;
    box-shadow: 0 4px 12px -8px rgba(20, 30, 60, 0.4);
  }
  .jacket img {
    height: 10.2rem; width: auto; display: block; border-radius: 2px;
    border: 1px solid rgba(26, 35, 50, 0.14);
  }
  /* the lit book — set by script, and by hover/focus */
  .jacket.lit, .jacket:hover, .jacket:focus-visible {
    opacity: 1; filter: none; transform: translateY(-5px);
    box-shadow: 0 16px 28px -14px rgba(20, 30, 60, 0.5);
  }
  .jacket:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 3px; }

  /* Rides along as the shelf scrolls — 33 books outlast the viewport. */
  .readout {
    position: sticky; top: 5.2rem;
    padding-left: 1.6rem; border-left: 2px solid var(--color-blue); min-height: 11rem;
  }
  .read { animation: readIn 0.45s ease both; }
  @keyframes readIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .read-cat { font-family: var(--font-body); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-blue); margin: 0 0 0.8rem; }
  .read-title { font-size: clamp(1.2rem, 1.6vw, 1.45rem); margin: 0 0 0.6rem; }
  .read-who { font-family: var(--font-display); font-style: italic; font-variation-settings: "opsz" 30; color: var(--color-ink); font-size: 0.95rem; margin: 0 0 0.55rem; }
  .read-note { font-size: 0.82rem; color: var(--color-ink-mute); line-height: 1.5; margin: 0; }


  @media (max-width: 980px) {
    .shelf-unit { grid-template-columns: 1fr; gap: 1.9rem; }
    /* Stacked: the readout moves above the books and pins under the nav,
       so tapping a jacket always updates something you can see. */
    .readout {
      order: -1; top: 4rem; z-index: 5; min-height: 7rem;
      background: var(--color-paper); padding-top: 0.6rem; padding-bottom: 0.6rem;
    }
    .jacket img { height: 10rem; }
  }
  @media (max-width: 560px) {
    .jacket img { height: 7.2rem; }
    .shelf { gap: 0.9rem 0.75rem; }
  }

  /* Motion off: every jacket sits lit, nothing travels, nothing fades. */
  @media (prefers-reduced-motion: reduce) {
    .jacket { opacity: 1; filter: none; transition: none; }
    .jacket.lit, .jacket:hover { transform: none; }
    .read { animation: none; }
  }
</style>

<script>
  const unit = document.getElementById("shelf");
  if (unit) {
    const jackets = [...unit.querySelectorAll<HTMLButtonElement>(".jacket")];
    const reads = [...unit.querySelectorAll<HTMLElement>(".read")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const HOLD = 2600;
    let at = 0, timer: number | undefined, onScreen = false, held = false;

    const light = (i: number) => {
      at = i;
      jackets.forEach((j, n) => j.classList.toggle("lit", n === i));
      reads.forEach((r, n) => {
        if (n === i) { r.hidden = false; r.style.animation = "none"; void r.offsetWidth; r.style.animation = ""; }
        else r.hidden = true;
      });
    };

    const stop = () => { clearInterval(timer); timer = undefined; };
    const run = () => {
      stop();
      if (reduced || !onScreen || held) return;
      timer = window.setInterval(() => light((at + 1) % jackets.length), HOLD);
    };

    // Taking over by hand parks the travelling highlight where you left it.
    jackets.forEach((j, i) => {
      const take = () => { light(i); held = true; run(); };
      const give = () => { held = false; run(); };
      j.addEventListener("mouseenter", take);
      j.addEventListener("focus", take);
      j.addEventListener("click", take);
      j.addEventListener("mouseleave", give);
      j.addEventListener("blur", give);
    });

    light(0);
    // Only travels while the shelf is actually on screen.
    new IntersectionObserver(
      (es) => es.forEach((e) => { onScreen = e.isIntersecting; run(); }),
      { threshold: 0.25 }
    ).observe(unit);
  }
</script>
